# CORS
ALLOWED_ORIGINS=["main-client.localhost"]
ALLOWED_CREDENTIALS=True
ALLOWED_METHODS=["*"]
ALLOWED_HEADERS=["*"]

# Database configuration
POSTGRES_SERVER=webapp-postgres
POSTGRES_PORT=5432
POSTGRES_DB=auth
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# JWT configuration
JWT_ENCRYPTION_ALGORITHM=HS256
