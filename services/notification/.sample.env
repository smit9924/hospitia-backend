# Runtime
# Local: ENVIRONMENT=local, LOG_FORMAT=console (daily files under bin/logs/)
# Production server: ENVIRONMENT=production, LOG_FORMAT=json (stdout only → Alloy → Loki)
ENVIRONMENT=local
SERVICE_NAME=notification
# 👇 DEBUG → INFO → WARNING → ERROR → CRITICAL
LOG_LEVEL=INFO
# 👇 json/console
LOG_FORMAT=console
LOG_RETENTION_DAYS=10

# which MQ software should be used
MQ_CLIENT_TYPE=rabbitmq

# RabbitMQ
RABBITMQ_HOST=${project_name}-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_HEART_BEAT=60
RABBITMQ_CONNECTION_TIMEOUT=300
RABBITMQ_RETRY_ATTEMPTS=5
RABBITMQ_RETRY_DELAY=5
RABBITMQ_USERNAME=developer
RABBITMQ_PASSWORD=password
RABBITMQ_PUBLISH_RETRY_ATTEMPTS=5
# 👇5 Seconds
RABBITMQ_PUBLISH_RETRY_DELAY=5
# 👇5 Seconds
RABBITMQ_CONSUMER_RETRY_DELAY=5
RABBITMQ_CONSUMER_PREFETCH_COUNT=3

# Notification topology
EMAIL_NOTIFICATION_EXCHANGE=email_notifications_exchange
EMAIL_NOTIFICATION_EXCHANGE_TYPE=direct

# Forgot password email queue
FORGOT_PASSWORD_EMAIL_QUEUE=forgot_password_email_queue
FORGOT_PASSWORD_EMAIL_QUEUE_ROUTING_KEY=forgot_password_email
FORGOT_PASSWORD_DEAD_LETTER_EMAIL_QUEUE=forgot_password_dead_letter_email_queue
FORGOT_PASSWORD_DEAD_LETTER_EMAIL_QUEUE_ROUTING_KEY=forgot_password_dead_letter_email
FORGOT_PASSWORD_EMAIL_RETRY_COUNT=3

# Verify email OTP email queue
VERIFY_EMAIL_OTP_EMAIL_QUEUE=verify_email_otp_email_queue
VERIFY_EMAIL_OTP_EMAIL_QUEUE_ROUTING_KEY=verify_email_otp_email
VERIFY_EMAIL_OTP_DEAD_LETTER_EMAIL_QUEUE=verify_email_otp_dead_letter_email_queue
VERIFY_EMAIL_OTP_DEAD_LETTER_EMAIL_QUEUE_ROUTING_KEY=verify_email_otp_dead_letter_email
VERIFY_EMAIL_OTP_EMAIL_RETRY_COUNT=3

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<your_email_address>
SMTP_PASSWORD=<your_email_password>
SMTP_FROM=<your_email_address>
SMTP_USE_TLS=True
