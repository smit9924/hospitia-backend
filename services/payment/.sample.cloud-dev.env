# =====================================================================
# Cloud development env sample (Claude Code cloud sessions, claude.ai/code)
#
# Why this file exists:
#   .sample.env targets the local devcontainer, where Postgres, RabbitMQ
#   and Mailpit are reached by Docker hostnames on the "dev-net" network
#   (webapp-postgres, ${project_name}-rabbitmq, webapp-mailpit).
#   In a cloud session there is no devcontainer: the VM itself is the
#   workspace, and those containers publish their ports on localhost,
#   so the Docker hostnames do not resolve.
#
# How it is used:
#   hospitia-master/scripts/cloud_bootstrap.sh copies this file to .env
#   (only when .env is missing, and only in cloud sessions). Locally,
#   .sample.env is still the file to copy.
#
# Differences from .sample.env (everything else is identical):
#   - Infrastructure hosts point to localhost instead of Docker hostnames.
#   Keep this file in sync with .sample.env when adding or changing keys.
#
# Contains local development values only. Never put real secrets here.
# =====================================================================

# Runtime
# Local: ENVIRONMENT=local, LOG_FORMAT=console (daily files under bin/logs/)
# Production server: ENVIRONMENT=production, LOG_FORMAT=json (stdout only → Alloy → Loki)
ENVIRONMENT=local
SERVICE_NAME=payment
# 👇 DEBUG → INFO → WARNING → ERROR → CRITICAL
LOG_LEVEL=INFO
# 👇 json/console
LOG_FORMAT=console
LOG_RETENTION_DAYS=10

# CORS
ALLOWED_ORIGINS=["http://main-client.localhost"]
ALLOWED_CREDENTIALS=True
ALLOWED_METHODS=["*"]
ALLOWED_HEADERS=["*"]

# Database configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=payment
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# JWT configuration
JWT_ENCRYPTION_ALGORITHM=HS256
JWT_ENCRYPTION_SECRET_KEY=530dc2ad82629ca706ec2b63558f788cc567ca6bbf680f10e3b70002bc8fb568

# which MQ software should be used
MQ_CLIENT_TYPE=rabbitmq

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_HEART_BEAT=60
RABBITMQ_CONNECTION_TIMEOUT=300
RABBITMQ_RETRY_ATTEMPTS=5
RABBITMQ_RETRY_DELAY=5
RABBITMQ_USERNAME=developer
RABBITMQ_PASSWORD=password
RABBITMQ_PUBLISH_RETRY_ATTEMPTS=5
# 👇5 Seconds
RABBITMQ_PUBLISH_RETRY_DELAY=5
# 👇5 Seconds
RABBITMQ_CONSUMER_RETRY_DELAY=5
RABBITMQ_CONSUMER_PREFETCH_COUNT=3

# Notification topology
EMAIL_NOTIFICATION_EXCHANGE=email_notifications_exchange
EMAIL_NOTIFICATION_EXCHANGE_TYPE=direct

# Forgot password email queue
FORGOT_PASSWORD_EMAIL_QUEUE=forgot_password_email_queue
FORGOT_PASSWORD_EMAIL_QUEUE_ROUTING_KEY=forgot_password_email

# User events topology
USER_EVENTS_EXCHANGE=user_events_exchange
USER_EVENTS_EXCHANGE_TYPE=topic
USER_CREATED_QUEUE=payment.user.created
USER_CREATED_QUEUE_ROUTING_KEY=auth.user.created
USER_CREATED_DEAD_LETTER_QUEUE=payment.user.created.dlq
USER_CREATED_DEAD_LETTER_QUEUE_ROUTING_KEY=payment.user.created.dlq
USER_CREATED_RETRY_COUNT=3

FRONTEND_BASE_URL=http://main-client.localhost
